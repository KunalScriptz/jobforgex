{
  "manifest_version": 3,
  "name": "JobForge Autofill",
  "version": "1.3.5",
  "description": "Save jobs to your JobForge board with one click from any job posting.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobForge",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.ashbyhq.com/*",
        "*://*.workday.com/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.linkedin.com/jobs/*",
        "*://*.indeed.com/*",
        "*://*.wellfound.com/*",
        "*://*.smartrecruiters.com/*",
        "*://*.jobvite.com/*",
        "*://*.naukri.com/*",
        "*://*.naukrigulf.com/*",
        "*://*.monster.com/*",
        "*://*.monsterindia.com/*",
        "*://*.glassdoor.com/*",
        "*://*.glassdoor.co.in/*",
        "*://*.ziprecruiter.com/*",
        "*://*.dice.com/*",
        "*://*.simplyhired.com/*",
        "*://*.foundit.in/*",
        "*://*.shine.com/*",
        "*://*.instahyre.com/*",
        "*://*.hirist.com/*",
        "*://*.iimjobs.com/*",
        "*://*.builtin.com/*",
        "*://*.remoteok.com/*",
        "*://*.weworkremotely.com/*",
        "*://*.otta.com/*",
        "*://*.ycombinator.com/*",
        "*://*.jobstreet.com/*",
        "*://*.jobstreet.com.my/*",
        "*://*.jobstreet.com.sg/*",
        "*://*.jobstreet.com.ph/*",
        "*://*.jobstreet.co.id/*",
        "*://*.seek.com.au/*",
        "*://*.seek.co.nz/*",
        "*://*/careers/*",
        "*://*/jobs/*",
        "*://*/*-jobs*/*",
        "*://*/job/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}