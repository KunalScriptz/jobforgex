# =============================================================================
# JobForge — Environment Configuration Template
#
# Usage:
#   cp .env.example .env
#   Edit .env with your secrets and URLs.
#   .env is gitignored — use different values on local vs production.
#
# Local dev:  URLs stay as localhost/service names (Vite proxy handles API)
# Production: set absolute URLs for your reverse proxy
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=jobforgex
DB_USER=jobforgex
DB_PASSWORD=change-me-to-a-secure-password

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# JWT Authentication
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-random-64-character-string-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# MinIO (S3-compatible object storage)
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=job-artifacts
MINIO_SECURE=false

# ---------------------------------------------------------------------------
# pgAdmin
# ---------------------------------------------------------------------------
PGADMIN_EMAIL=admin@jobforge.local
PGADMIN_PASSWORD=admin

# ---------------------------------------------------------------------------
# DeepSeek AI
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_INPUT_PRICE_PER_1M=0.14
DEEPSEEK_OUTPUT_PRICE_PER_1M=0.28
DEEPSEEK_KEY_ENC_SECRET=change-me-to-a-random-32-char-secret

# ---------------------------------------------------------------------------
# LaTeX Compiler
# ---------------------------------------------------------------------------
LATEX_COMPILE_URL=http://latex-server:5959
LATEX_SHARED_SECRET=

# ---------------------------------------------------------------------------
# Razorpay (Payments)
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ---------------------------------------------------------------------------
# SMTP (Email verification, password reset, digests)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=JobForge <noreply@jobforge.local>

# ---------------------------------------------------------------------------
# Scheduled digest email (off by default; set true to send the twice-daily summary)
# ---------------------------------------------------------------------------
DIGEST_ENABLED=false

# ---------------------------------------------------------------------------
# Feature flags (ship dark; the sidebar hides pages whose flag is off)
# ---------------------------------------------------------------------------
FEATURE_PIPELINE=false
FEATURE_GMAIL=false

# ---------------------------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5454/api/v1/auth/google/callback

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# Add your own domain(s), comma separated, when you deploy (the "*" entry is needed for the Chrome extension)
CORS_ORIGINS=*,http://localhost:5173,http://localhost:5454

# Frontend API URL — leave empty for local dev (uses Vite proxy)
# Production: set to your API domain, e.g. https://api.example.com
VITE_API_URL=
